# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
vite.config.js
vite.config.d.ts
next-env.d.ts

# Convex local development
/.convex/

# Cloudflare local development
/.wrangler/

# SQL files
*.sql
